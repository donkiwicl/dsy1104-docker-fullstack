# Copia este archivo como .env y cambia las claves. El .env real NO se sube a Git.

# --- Base de datos ---
DB_NAME=appdb
DB_USER=appuser
DB_PASSWORD=cambia_esta_clave
DB_ROOT_PASSWORD=cambia_esta_clave_root

# --- Puertos publicados en tu máquina (docker-compose.yml) ---
BACKEND_PORT=8080
FRONTEND_PORT=80

# --- Solo para producción (docker-compose.prod.yml) ---
DOCKERHUB_USER=tu_usuario
IMAGE_TAG=1.0
